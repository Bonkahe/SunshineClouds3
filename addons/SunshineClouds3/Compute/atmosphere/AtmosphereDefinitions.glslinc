/*
atmosphere/definitions.glsl: physical types and constants used by functions.glsl. GLSL has no typedef or
custom numeric types, so physical quantities are float macros (Bruneton's C++ reference version enforces
units at compile time). Six base quantities follow.
*/

#define Length float
#define Wavelength float
#define Angle float
#define SolidAngle float
#define Power float
#define LuminousPower float

/* Derived quantities. */

#define Number float
#define InverseLength float
#define Area float
#define Volume float
#define NumberDensity float
#define Irradiance float
#define Radiance float
#define SpectralPower float
#define SpectralIrradiance float
#define SpectralRadiance float
#define SpectralRadianceDensity float
#define ScatteringCoefficient float
#define InverseSolidAngle float
#define LuminousIntensity float
#define Luminance float
#define Illuminance float

/* Spectra: each vec3 element is the function's value at one of the predefined wavelengths. */

// A generic function from Wavelength to some other type.
#define AbstractSpectrum vec3
// A function from Wavelength to Number.
#define DimensionlessSpectrum vec3
// A function from Wavelength to SpectralPower.
#define PowerSpectrum vec3
// A function from Wavelength to SpectralIrradiance.
#define IrradianceSpectrum vec3
// A function from Wavelength to SpectralRadiance.
#define RadianceSpectrum vec3
// A function from Wavelength to SpectralRadianceDensity.
#define RadianceDensitySpectrum vec3
// A function from Wavelength to ScatteringCoefficient.
#define ScatteringSpectrum vec3

// A position in 3D (3 length values).
#define Position vec3
// A unit direction vector in 3D.
#define Direction vec3
#define Luminance3 vec3
#define Illuminance3 vec3

/* Precomputed textures of physical quantities. */

#define TransmittanceTexture sampler2D
#define AbstractScatteringTexture sampler3D
#define ReducedScatteringTexture sampler3D
#define ScatteringTexture sampler3D
#define ScatteringDensityTexture sampler3D
#define IrradianceTexture sampler2D

/* Base units. */

const Length m = 1.0;
const Wavelength nm = 1.0;
const Angle rad = 1.0;
const SolidAngle sr = 1.0;
const Power watt = 1.0;
const LuminousPower lm = 1.0;

/* Derived units. */

const float PI = 3.14159265358979323846;

const Length km = 1000.0 * m;
const Area m2 = m * m;
const Volume m3 = m * m * m;
const Angle pi = PI * rad;
const Angle deg = pi / 180.0;
const Irradiance watt_per_square_meter = watt / m2;
const Radiance watt_per_square_meter_per_sr = watt / (m2 * sr);
const SpectralIrradiance watt_per_square_meter_per_nm = watt / (m2 * nm);
const SpectralRadiance watt_per_square_meter_per_sr_per_nm =
    watt / (m2 * sr * nm);
const SpectralRadianceDensity watt_per_cubic_meter_per_sr_per_nm =
    watt / (m3 * sr * nm);
const LuminousIntensity cd = lm / sr;
const LuminousIntensity kcd = 1000.0 * cd;
const Luminance cd_per_square_meter = cd / m2;
const Luminance kcd_per_square_meter = kcd / m2;

/* Atmosphere parameters. */

// A layer of width 'width' whose density at altitude h is, clamped to [0,1],
//   'exp_term' * exp('exp_scale' * h) + 'linear_term' * h + 'constant_term'.
struct DensityProfileLayer {
  Length width;
  Number exp_term;
  InverseLength exp_scale;
  InverseLength linear_term;
  Number constant_term;
};

// Layers stacked bottom to top; the last layer's width is ignored (it extends to the top of the
// atmosphere). Values range from 0 (null density) to 1 (maximum density).
struct DensityProfile {
  DensityProfileLayer layers[2];
};

struct AtmosphereParameters {
  // Solar irradiance at the top of the atmosphere.
  IrradianceSpectrum solar_irradiance;
  // Must be below 0.1 rad: the implementation's approximations assume a small sun.
  Angle sun_angular_radius;
  // Distance from the planet center to the bottom of the atmosphere.
  Length bottom_radius;
  // Distance from the planet center to the top of the atmosphere.
  Length top_radius;
  // Air molecule density, altitude -> 0 (null) .. 1 (maximum).
  DensityProfile rayleigh_density;
  // Air molecule scattering coefficient where density is maximum (usually the ground), per wavelength.
  // At altitude h it is this times rayleigh_density(h).
  ScatteringSpectrum rayleigh_scattering;
  // Aerosol density, altitude -> 0 (null) .. 1 (maximum).
  DensityProfile mie_density;
  // Aerosol scattering coefficient where density is maximum, per wavelength; times mie_density(h) at altitude h.
  ScatteringSpectrum mie_scattering;
  // Aerosol extinction coefficient where density is maximum, per wavelength; times mie_density(h) at altitude h.
  ScatteringSpectrum mie_extinction;
  // Asymmetry parameter of the aerosols' Cornette-Shanks phase function.
  Number mie_phase_function_g;
  // Density of light-absorbing molecules (e.g. ozone), altitude -> 0 (null) .. 1 (maximum).
  DensityProfile absorption_density;
  // Absorber extinction coefficient where density is maximum, per wavelength; times absorption_density(h).
  ScatteringSpectrum absorption_extinction;
  // Average ground albedo.
  DimensionlessSpectrum ground_albedo;
  // Cosine of the maximum sun zenith angle to precompute for. For best precision use the smallest angle
  // giving negligible sky radiance (Earth: 102 degrees, mu_s_min = -0.2).
  Number mu_s_min;
};
